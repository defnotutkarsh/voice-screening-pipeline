# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Google Gemini API key, used only by `voice-screening build` to read resumes.
GEMINI_API_KEY=
# Optional. Any Gemini model that supports JSON-schema output.
GEMINI_MODEL=gemini-3.8-flash

# Optional. If set, the results server rejects any webhook that does not send
# this value in the X-Webhook-Secret header.
WEBHOOK_SECRET=

# Optional. Comma-separated hostnames the results server may download
# transcripts from. Empty means: never fetch a URL, accept inline text only.
TRANSCRIPT_HOSTS=
